---
// Past editions section linking to previous retreats
import type { Edition } from "../data/editions";

interface Props {
  editions: Edition[];
}

const { editions } = Astro.props;
---

<section class="py-16 px-4 bg-stone-100">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-stone-800 mb-6">
      Edizioni passate
    </h2>
    <p class="text-lg text-stone-600 mb-8">
      Scopri le edizioni precedenti del Ritiro Nomade
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      {
        editions.map((edition) => (
          <a
            href={edition.href}
            class="inline-block px-8 py-4 bg-green-200 text-black font-semibold rounded-lg hover:bg-green-300 transition-colors duration-300 shadow-md hover:shadow-lg"
          >
            {edition.heroTitle}, {edition.location.split(",")[0]},{" "}
            {edition.dateLabel}
          </a>
        ))
      }
    </div>
  </div>
</section>
