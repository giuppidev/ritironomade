---
// src/components/WaitlistScript.astro
// Wires every [data-waitlist] form to the community signup API.
---

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-waitlist]").forEach((form) => {
    const root = form.closest("[data-waitlist-root]") ?? form;
    const success = root.querySelector<HTMLElement>("[data-waitlist-success]");
    const error = root.querySelector<HTMLElement>("[data-waitlist-error]");
    const input = form.querySelector<HTMLInputElement>('input[type="email"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = input?.value.trim();
      if (!email || !button) return;

      const label = button.textContent;
      button.textContent = button.dataset.loading ?? "Invio...";
      button.disabled = true;

      try {
        const response = await fetch("https://www.giuppi.dev/api/ritiro-nomade", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        if (!response.ok) throw new Error("API request failed");
        success?.classList.remove("hidden");
        error?.classList.add("hidden");
        if (input) input.value = "";
      } catch {
        error?.classList.remove("hidden");
        success?.classList.add("hidden");
      } finally {
        button.textContent = label;
        button.disabled = false;
      }
    });
  });
</script>
