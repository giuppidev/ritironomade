---
// src/components/EditionList.astro
// Edition cards: photo, date, serif name, place and a button to open the edition.
import { homeEditions, type Edition } from "../data/editions";
import { editionMedia } from "../data/media";
import { isOpen } from "../data/retreat";
import Media from "./Media.astro";

interface Props {
  exclude?: Edition["slug"];
}

const { exclude } = Astro.props;
// The open edition (next retreat) always comes first.
const list = homeEditions
  .filter((edition) => edition.slug !== exclude)
  .sort((first, second) => Number(isOpen(second)) - Number(isOpen(first)));
---

<ol class:list={["grid gap-x-6 gap-y-14 sm:grid-cols-2", list.length > 3 ? "lg:grid-cols-4" : "lg:grid-cols-3"]}>
  {
    list.map((edition) => (
      <li>
        <a href={`/${edition.slug}`} class="group block">
          <div class="relative mb-6">
            <Media
              slot={editionMedia[edition.slug]}
              still
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              class="aspect-[4/5] rounded-xl"
              mediaClass="transition duration-700 group-hover:scale-[1.03]"
            />
            <span
              class:list={[
                "eyebrow absolute left-4 top-4 rounded-full px-3 py-1.5 !text-[10px]",
                isOpen(edition) ? "bg-[var(--paper)] text-black" : "border border-white/40 bg-black/30 text-white backdrop-blur",
              ]}
            >
              {isOpen(edition) ? "Prossimo ritiro" : "Conclusa"}
            </span>
          </div>
          <p class="eyebrow mb-2 text-[var(--ember)]">{edition.dateLabel}</p>
          <h3 class="serif mb-2 text-3xl leading-tight">{edition.heroTitle}</h3>
          <p class="lead text-[var(--stone)]">{edition.location}</p>
          <span class:list={["btn mt-5 !px-4 !py-2 !text-[14px]", isOpen(edition) ? "btn-light" : "btn-ghost"]}>
            Scopri l'edizione <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>
