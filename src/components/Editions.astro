---
import { Calendar, MapPin } from "@lucide/astro";
import { homeEditions } from "../data/editions";
---

<section id="editions" class="py-20 px-4 bg-stone-50">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-light text-stone-800 mb-4">
        Edizioni
      </h2>
      <p class="text-lg text-stone-600 max-w-2xl mx-auto">
        Tre ritiri nomadi, tre luoghi diversi, lo stesso modo di vivere lavoro,
        community e tempo insieme.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        homeEditions.map((edition) => (
          <a
            href={edition.href}
            class="group relative min-h-[420px] overflow-hidden rounded-lg bg-stone-900 shadow-lg transition-transform duration-300 hover:-translate-y-1 focus:outline-none focus:ring-4 focus:ring-primary/40"
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105"
              style={`background-image: url(${edition.image});`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/20" />
            <div class="relative z-10 flex h-full min-h-[420px] flex-col justify-between p-6 text-white">
              <div>
                <span class="inline-flex rounded-full bg-white/15 px-3 py-1 text-sm font-medium backdrop-blur-sm">
                  {edition.status.label}
                </span>
              </div>

              <div>
                <h3 class="mb-4 text-4xl font-bold leading-tight">
                  {edition.heroTitle}
                </h3>
                <div class="mb-4 space-y-2 text-sm text-white/85">
                  <p class="flex items-center gap-2">
                    <Calendar class="h-4 w-4" />
                    <span>{edition.dateLabel}</span>
                  </p>
                  <p class="flex items-center gap-2">
                    <MapPin class="h-4 w-4" />
                    <span>{edition.location}</span>
                  </p>
                </div>
                <p class="mb-6 text-base leading-relaxed text-white/90">
                  {edition.cardDescription}
                </p>
                <span class="inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-stone-900 transition-colors group-hover:bg-stone-100">
                  Scopri l'edizione
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
