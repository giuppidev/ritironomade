---
import EditionDetail from "../components/EditionDetail.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Waitlist from "../components/Waitlist.astro";
import { getEdition } from "../data/editions";
import Layout from "../layouts/Layout.astro";
import "../styles/globals.css";

const edition = getEdition("january-2026");

if (!edition) {
  throw new Error("Edition january-2026 not found");
}
---

<Layout title="Ritiro nomade">
  <div class="min-h-screen bg-stone-50">
    <Hero
      title={edition.heroTitle}
      subtitle={edition.location}
      style="!min-h-[400px]"
      showHomeButton={true}
      backgroundImage={edition.image}
    />
    <EditionDetail edition={edition} />
    <FAQ />
    <Waitlist />
    <Footer />
  </div>
</Layout>
