---
// src/pages/index.astro
// Homepage. Flow: hero (con prossima edizione) → il ritiro + carosello + pilastri → giornata tipo → unconference → edizioni → chi sono → form + FAQ.
import Closing from "../components/Closing.astro";
import Deco from "../components/Deco.astro";
import EditionList from "../components/EditionList.astro";
import Header from "../components/Header.astro";
import Media from "../components/Media.astro";
import { galleryKeys } from "../data/media";
import { intro, nextEdition, pillars, sortedActivities, typicalDay } from "../data/retreat";
import Layout from "../layouts/Layout.astro";

const unconferenceSteps = [
  "Si parte da un cartellone vuoto, con gli spazi e gli orari della giornata.",
  "Chi vuole scrive su un post-it una domanda, un tema o un talk da proporre.",
  "I post-it finiscono sul cartellone, ognuno sceglie dove andare e la giornata prende forma.",
];

// The afternoon is left free: show "Attività libere" at 14:00 instead of as an all-day parallel track.
const dayActivities = sortedActivities(typicalDay)
  .map((activity) =>
    activity.title === "Attività libere" ? { ...activity, time: "14:00 – 19:30", startHour: 14 } : activity,
  )
  .sort((first, second) => first.startHour - second.startHour);

---

<Layout title="Ritiro Nomade · Cercatori di libertà, una scelta alla volta" socialTitle="Ritiro Nomade">
  <Header />

  <main>
  <!-- Hero -->
  <section class="on-dark relative isolate flex h-svh min-h-[600px] flex-col overflow-hidden bg-[var(--night)]">
    <Media
      slot="heroMontage"
      eager
      mediaClass="[filter:saturate(1.1)_contrast(1.05)]"
      class="!absolute inset-0 -z-10"
      overlayClass="bg-[linear-gradient(to_top,rgb(10_20_15)_0%,rgb(10_20_15/0.94)_10%,rgb(10_20_15/0.74)_26%,rgb(10_20_15/0.36)_50%,rgb(10_20_15/0.05)_72%,rgb(10_20_15/0.4)_100%)]"
    />
    <div class="mt-auto flex w-full flex-col px-6 pb-8 md:flex-row md:items-end md:justify-between md:gap-12 md:px-14 md:pb-12">
      <div>
        <h1 class="serif text-[min(8.4vw,46px)] leading-[1.1] [text-shadow:0_2px_24px_rgb(0_0_0/0.35)] md:text-[clamp(46px,4.6vw,80px)]">
          Cercatori di libertà.<br /><em>Una scelta alla volta.</em>
        </h1>
        <p class="mt-4 max-w-[34rem] text-[16px] leading-[1.45] text-[var(--paper)]/85 [text-shadow:0_1px_12px_rgb(0_0_0/0.45)] md:mt-5 md:text-[18px]">
          Un ritiro nella natura per chi lavora da remoto. Quattro giorni di condivisione, confronto e domande. Tante domande.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a href="#ritiro" class="btn btn-light shrink-0 !px-4 md:!px-6">Scopri di più</a>
          <!-- On phones the next edition sits beside the button; on desktop it moves to the right edge. -->
          <div class="min-w-0 border-l border-[var(--line)] pl-3 md:hidden">
            <p class="eyebrow !text-[10px] !tracking-[0.14em] text-[var(--ember)]">Prossima edizione</p>
            <p class="serif mt-0.5 text-[15px] leading-tight">{nextEdition.location}</p>
            <p class="mt-0.5 text-[12px] leading-tight text-[var(--stone)]">{nextEdition.dateLabel}</p>
          </div>
        </div>
      </div>
      <div class="hidden shrink-0 border-l border-[var(--line)] pb-1 pl-6 md:block">
        <p class="eyebrow mb-1.5 text-[var(--ember)]">Prossima edizione</p>
        <p class="serif text-[21px] leading-tight">{nextEdition.location}</p>
        <p class="mt-1 text-[15px] text-[var(--stone)]">{nextEdition.dateLabel}</p>
      </div>
    </div>
  </section>

  <!-- Il ritiro + carosello -->
  <section id="ritiro" class="on-dark relative isolate overflow-hidden bg-[var(--ink)] py-24 md:py-32">
    <Deco kind="map" class="inset-x-0 -top-[8vw] w-full !opacity-[0.12] [mask-image:linear-gradient(to_bottom,transparent_8vw,black_45%)]" />
    <div class="mx-auto max-w-6xl px-6 md:px-14 xl:px-0">
      <div class="grid gap-10 md:grid-cols-[1.2fr_2fr] md:gap-12">
        <div>
          <p class="eyebrow mb-5 text-[var(--ember)]">Il ritiro</p>
          <h2 class="serif h-section">Che cos'è un Ritiro Nomade?</h2>
        </div>
        <p class="lead max-w-xl text-[var(--stone)]">{intro}</p>
      </div>
    </div>

    <div class="mt-16 md:mt-20" data-carousel>
      <div data-carousel-track class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth scroll-px-6 px-6 md:scroll-px-14 md:px-14">
        {
          galleryKeys.map((key) => (
            <Media slot={key} sizes="(min-width: 1024px) 26vw, (min-width: 640px) 42vw, 72vw" class="aspect-[4/5] w-[72vw] shrink-0 snap-start rounded-xl sm:w-[42vw] lg:w-[26vw]" />
          ))
        }
      </div>
      <div class="mt-8 flex items-center justify-between px-6 md:px-14">
        <div class="flex items-center gap-2" data-carousel-dots aria-hidden="true">
          {galleryKeys.map(() => <span class="h-1.5 w-1.5 rounded-full bg-[var(--paper-2)]/30 transition-all duration-300" />)}
        </div>
        <div class="flex gap-2">
          <button type="button" data-carousel-prev aria-label="Foto precedente" class="btn btn-ghost !h-11 !w-11 !p-0">←</button>
          <button type="button" data-carousel-next aria-label="Foto successiva" class="btn btn-ghost !h-11 !w-11 !p-0">→</button>
        </div>
      </div>
    </div>
    <div class="mx-auto mt-20 grid max-w-6xl gap-10 px-6 md:mt-28 md:grid-cols-3 md:gap-12 md:px-14 xl:px-0">
      {
        pillars.map((pillar) => (
          <div class="border-t border-[var(--line)] pt-6">
            <h3 class="serif mb-3 text-2xl">{pillar.title}</h3>
            <p class="leading-relaxed text-[var(--stone)]">{pillar.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Programma: giornata tipo -->
  <section id="giornata" class="on-dark relative isolate overflow-hidden border-t border-[var(--line)] bg-[var(--ink)] px-6 py-24 md:px-14 md:py-32">
    <div class="contours absolute inset-0" aria-hidden="true"></div>
    <Deco kind="river" class="inset-x-0 -bottom-[12vw] w-full !opacity-[0.05]" />
    <div class="relative mx-auto grid max-w-6xl items-start gap-14 md:grid-cols-2">
      <Media slot="dayMontage" class="aspect-[4/5] rounded-xl md:sticky md:top-12" />
      <div>
        <p class="eyebrow mb-5 text-[var(--ember)]">Programma</p>
        <h2 class="serif h-section mb-10">Una giornata tipo</h2>
        <ol class="mb-10 border-t border-[var(--line)]">
          {
            dayActivities.map((activity) => (
              <li class="grid grid-cols-[4rem_1fr] items-baseline gap-4 border-b border-[var(--line)] py-4">
                <span class="serif text-[var(--paper)]">{activity.time.split("–")[0].trim()}</span>
                <span class="text-[var(--stone)]">{activity.title}</span>
              </li>
            ))
          }
        </ol>
        <a href="#partecipa" class="btn btn-light">Partecipa</a>
      </div>
    </div>
  </section>

  <!-- Unconference -->
  <section id="unconference" class="relative isolate overflow-clip bg-[var(--paper)] text-[var(--moss)]">
    <Deco kind="map" tone="ink" class="inset-x-0 -bottom-[14vw] w-full" />
    <div class="mx-auto grid max-w-7xl items-start gap-12 px-6 py-24 md:grid-cols-[1.1fr_1fr] md:gap-16 md:px-14 md:py-32">
      <div>
        <p class="eyebrow mb-5 text-[var(--ember)]">Il formato</p>
        <h2 class="serif h-section mb-6 text-black">Che cos'è l'unconference?</h2>
        <p class="lead mb-10 max-w-xl">
          Una conferenza senza palco e senza scaletta. Il programma parte vuoto: ogni partecipante propone una domanda, un
          tema o un talk, e insieme si costruisce la giornata.
        </p>
        <ol class="mb-8 max-w-xl border-t border-black/15">
          {
            unconferenceSteps.map((step, index) => (
              <li class="grid grid-cols-[3rem_1fr] items-baseline border-b border-black/15 py-4">
                <span class="serif text-[var(--ember)]">{String(index + 1).padStart(2, "0")}</span>
                <span class="text-black">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <Media slot="unconferenceMontage" class="order-first aspect-[4/5] rounded-xl md:order-none md:sticky md:top-12" />
    </div>
  </section>

  <!-- Edizioni -->
  <section id="edizioni" class="on-dark relative isolate overflow-hidden bg-[var(--ink)] px-6 py-24 md:px-14 md:py-32">
    <Deco kind="topo" class="inset-x-0 -top-[12vw] w-full !opacity-[0.05]" />
    <div class="mx-auto max-w-7xl">
      <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow mb-5 text-[var(--ember)]">Edizioni</p>
          <h2 class="serif h-section">Ogni stagione, una casa.</h2>
        </div>
        <p class="lead max-w-sm text-[var(--stone)]">Luoghi diversi, lo stesso modo di vivere lavoro, community e tempo insieme.</p>
      </div>
      <EditionList />
    </div>
  </section>

  <!-- Chi lo organizza -->
  <section id="chi-sono" class="relative isolate overflow-hidden bg-[var(--paper)] px-6 py-24 md:px-14 md:py-32">
    <Deco kind="river" tone="ink" class="inset-x-0 -top-[16vw] w-full" />
    <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
      <img
        src="/media/giuppi.webp"
        alt="Giuppi durante un viaggio in montagna"
        loading="lazy"
        class="aspect-[4/5] w-full max-w-sm rounded-xl object-cover"
      />
      <div>
        <p class="eyebrow mb-5 text-[var(--ember)]">Chi lo organizza</p>
        <h2 class="serif h-section mb-6 text-black">Ciao, sono Giuppi.</h2>
        <p class="lead mb-8 max-w-xl text-[var(--stone)]">
          Mi chiamo Giuseppe Funicello: developer, YouTuber e nomade digitale da più di dieci anni, con una delle più grandi
          community italiane di freelance developer e indie hacker. Ho deciso di organizzare per la mia community un'esperienza nomade: quattro giorni
          nella natura a lavorare e a conoscersi.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="https://www.giuppi.dev" target="_blank" rel="noreferrer" class="btn btn-ghost-dark">giuppi.dev</a>
          <a href="https://www.youtube.com/@giuppidev" target="_blank" rel="noreferrer" class="btn btn-ghost-dark">YouTube</a>
          <a href="https://www.giuppi.dev/discord" target="_blank" rel="noreferrer" class="btn btn-ghost-dark">Discord</a>
        </div>
      </div>
    </div>
  </section>

  </main>

  <Closing />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]")!;
    const dots = [...root.querySelectorAll<HTMLElement>("[data-carousel-dots] span")];
    const slides = [...track.children] as HTMLElement[];
    const step = () => (slides[1]?.offsetLeft ?? 0) - (slides[0]?.offsetLeft ?? 0);
    const current = () => Math.round(track.scrollLeft / (step() || 1));
    const go = (index: number) => track.scrollTo({ left: Math.max(0, Math.min(index, slides.length - 1)) * step() });
    const sync = () => {
      const active = Math.min(current(), dots.length - 1);
      dots.forEach((dot, index) => {
        dot.classList.toggle("!w-6", index === active);
        dot.classList.toggle("!bg-[var(--paper-2)]", index === active);
      });
    };
    root.querySelector("[data-carousel-prev]")?.addEventListener("click", () => go(current() - 1));
    root.querySelector("[data-carousel-next]")?.addEventListener("click", () => go(current() + 1));
    track.addEventListener("scroll", sync, { passive: true });
    sync();
  });
</script>
